# Copy to .env for local settings. Never commit real secrets.
# Everything is optional: with no keys FinCo runs on rules and templates.

# A model for paraphrased questions, wording and unfamiliar shops.
# Use one key, or several separated by commas to spread the rate limit.
GEMINI_API_KEY=your_api_key_here
# GEMINI_API_KEYS=key_one,key_two
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM_LIMIT=15

# Force the model off even if keys are present.
# FINCO_LLM=off

# Ask about payments of at least this many paise (default 5000, which is Rs 50).
# FINCO_MIN_ASK_PAISE=100

# Phone notifications (Web Push). Generate a pair with any VAPID tool.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
